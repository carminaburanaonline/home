@article{bourgain_quest-ce_1989,
	title = {Qu'est-ce qu'un vers au {Moyen} {Age} ?},
	volume = {147},
	copyright = {free},
	shorttitle = {Qu'est-ce qu'un vers},
	url = {https://www.persee.fr/doc/bec_0373-6237_1989_num_147_1_450536},
	doi = {10.3406/bec.1989.450536},
	abstract = {Pascale Bourgain, Qu'est-ce qu'un vers au Moyen Age ? — Bibliothèque de l'École des chartes, t. 147, 1989, p. 231-282. Au Moyen Age, l'existence de deux types de poésie, métrique et rythmique, déséquilibre l'opposition prose/vers. Une étude sémantique du mot versus , utilisé au sens général de « portion de texte », qui prend des acceptions diverses dans le domaine liturgique, dans celui de la ponctuation et en poésie, montre que le mot désigne un fragment de texte ayant des caractères techniques précis : ligne d'écriture, verset ; en poésie, vers, ou strophe, mais aussi, jusqu'au XIe siècle, un poème entier, toujours rythmique en ce cas. Au XIIIe siècle, sans doute sous l'influence des théoriciens des arts poétiques et des enseignants, le terme est évité dans le domaine rythmique et désigne plutôt des vers métriques. Toujours moins solennelle que pour les vers métriques, la disposition des poésies rythmiques dans les manuscrits (en continu, par strophe, par groupe de vers, par vers) montre que les copistes ont traduit sur la page leur perception de la structure en donnant la vedette à l'un des niveaux organiques du poème. Peut-être ne savait-on pas au juste, en poésie rythmique, auquel de ces niveaux s'appliquait le mot « vers ».},
	language = {fr},
	number = {1},
	urldate = {2025-01-18},
	journal = {Bibliothèque de l'École des chartes},
	author = {Bourgain, Pascale},
	year = {1989},
	note = {Company: Persée - Portail des revues scientifiques en SHS
Distributor: Persée - Portail des revues scientifiques en SHS
Institution: Persée - Portail des revues scientifiques en SHS
Label: Persée - Portail des revues scientifiques en SHS},
	keywords = {Versification, Latin, Rythmique},

@article{thomson_origins_1978,
	title = {The {Origins} of {Latin} {Satire} in {Twelfth} {Century} {Europe}},
	volume = {13},
	shorttitle = {Origins},
	abstract = {The twelfth century saw a remarkable upsurge of literary production in western Europe. Insofar as much of this literature was related to the teachings of the Christian Church, its growth is, prima facie, explicable in terms of the movement for ecclesiastical reform (in the widest sense of the term) from c. 1050 on, and in terms of the educational developments of the century after c. 1100. But some genres, notably lyric poetry, the poetry of courtly love, and satire both prose and verse, appear in an abundance which cannot be accounted for so obviously. The case of satire is particularly remarkable and difficult to explain.},
	journal = {Mittellateinisches Jahrbuch},
	author = {Thomson, Rodney M.},
	year = {1978},
	pages = {73--83},
}


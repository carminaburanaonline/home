<TEI>
  <teiHeader/>
  <text>
    <body>
      <div type="sequence">
        <lg type="versicle" n="1a" xml:id="CB036_emn_PB-lg-1">
          <l n="1" xml:id="CB036_emn_PB-l-1">Personne n&#8217;est priv&#233;</l>
          <l n="2" xml:id="CB036_emn_PB-l-2">du bienfait d&#8217;un juste</l>
          <l n="3" rend="indent(1)" xml:id="CB036_emn_PB-l-3">ch&#226;timent,</l>
          <l n="4" xml:id="CB036_emn_PB-l-4">personne ne se voit</l>
          <l n="5" xml:id="CB036_emn_PB-l-5">reprocher de pire vice</l>
          <l n="6" rend="indent(1)" xml:id="CB036_emn_PB-l-6">que l&#8217;ingratitude.</l>
          <l n="7" xml:id="CB036_emn_PB-l-7">Donc, pr&#233;lat, quand tu te confesses,</l>
          <l n="8" xml:id="CB036_emn_PB-l-8">repens-toi v&#233;ritablement,</l>
          <l n="9" xml:id="CB036_emn_PB-l-9">car n&#8217;est pas lav&#233; par la confession</l>
          <l n="10" xml:id="CB036_emn_PB-l-10">celui &#224; qui est refus&#233;e</l>
          <l n="11" rend="indent(1)" xml:id="CB036_emn_PB-l-11">la contrition.</l>
        </lg>
        <lg type="versicle" n="2a" xml:id="CB036_emn_PB-lg-2">
          <l n="1" xml:id="CB036_emn_PB-l-12">Il faut utiliser la vertu,</l>
          <l n="2" rend="indent(1)" xml:id="CB036_emn_PB-l-13">non le sang;</l>
          <l n="3" xml:id="CB036_emn_PB-l-14">au sommet des honneurs,</l>
          <l n="4" rend="indent(1)" xml:id="CB036_emn_PB-l-15">d&#8217;un c&#339;ur patient,</l>
          <l n="5" xml:id="CB036_emn_PB-l-16">favorise l&#8217;innocent.</l>
          <l n="6" xml:id="CB036_emn_PB-l-17">Mais r&#233;prime les forfaits</l>
          <l n="7" xml:id="CB036_emn_PB-l-18">de l&#8217;orgueilleux et de l&#8217;impie.</l>
          <l n="8" xml:id="CB036_emn_PB-l-19">Songe au dernier jugement,</l>
          <l n="9" xml:id="CB036_emn_PB-l-20">juge justement,</l>
          <l n="10" xml:id="CB036_emn_PB-l-21">ne d&#233;vie pas en pr&#234;chant.</l>
        </lg>
        <lg type="versicle" n="3a" xml:id="CB036_emn_PB-lg-3">
          <l n="1" xml:id="CB036_emn_PB-l-22">Celui &#224; qui plus est confi&#233;,</l>
          <l n="2" xml:id="CB036_emn_PB-l-23">de lui il est plus exig&#233;.</l>
          <l n="3" xml:id="CB036_emn_PB-l-24">Pourquoi rends-tu au Seigneur,</l>
          <l n="4" xml:id="CB036_emn_PB-l-25">pour tout ce dont il t&#8217;a combl&#233;,</l>
          <l n="5" xml:id="CB036_emn_PB-l-26">d&#8217;arracher son lait et sa laine</l>
          <l n="6" xml:id="CB036_emn_PB-l-27">au troupeau dont il t&#8217;a charg&#233;</l>
          <l n="7" rend="indent(1)" xml:id="CB036_emn_PB-l-28">comme berger ?</l>
          <l n="8" xml:id="CB036_emn_PB-l-29">Mais gare, quand il viendra,</l>
          <l n="9" xml:id="CB036_emn_PB-l-30">qu&#8217;alors il t&#8217;&#233;crase durement,</l>
          <l n="10" rend="indent(1)" xml:id="CB036_emn_PB-l-31">comme un brigand !</l>
          <l n="11" xml:id="CB036_emn_PB-l-32">Il viendra en juge s&#233;v&#232;re,</l>
          <l n="12" xml:id="CB036_emn_PB-l-33">&#224; pr&#233;sent, jaugeant ton p&#233;ch&#233;,</l>
          <l n="13" rend="indent(1)" xml:id="CB036_emn_PB-l-34">il te laisse faire.</l>
        </lg>
      </div>
    </body>
  </text>
</TEI>
  <text>
    <body>
      <div type="poem" met="I-III:2x(7pp+6p)">
        <lg type="strophe" n="I" met="7pp+6p/7pp+6p" rhyme="A+B/A+B" xml:id="CB090_5539-lg-1">
          <l n="1" xml:id="CB090_5539-l-1">
            <seg type="hemistich">
              <w>Exiit</w>
              <w>diluculo</w>
            </seg>
            <seg type="hemistich">
              <w>rustica</w>
              <w>puella</w>
            </seg>
          </l>
          <l n="2" xml:id="CB090_5539-l-2">
            <seg type="hemistich">
              <w>cum</w>
              <w>grege</w>
              <pc resp="#editor">,</pc>
              <w>cum</w>
              <w>baculo</w>
              <pc resp="#editor">,</pc>
            </seg>
            <seg type="hemistich">
              <w>cum</w>
              <w>lana</w>
              <w>novella</w>
              <pc resp="#editor">.</pc>
            </seg>
          </l>
        </lg>
        <lg type="strophe" n="II" met="7pp+6p/7pp+6p" rhyme="A+B/A+B" xml:id="CB090_5539-lg-2">
          <l n="1" xml:id="CB090_5539-l-3">
            <seg type="hemistich">
              <w>Sunt</w>
              <w>in</w>
              <w>grege</w>
              <w>parvulo</w>
            </seg>
            <seg type="hemistich">
              <w>ovis</w>
              <w>et</w>
              <w>asella</w>
              <pc resp="#editor">,</pc>
            </seg>
          </l>
          <l n="2" xml:id="CB090_5539-l-4">
            <seg type="hemistich">
              <w>vitula</w>
              <w>cum</w>
              <w>vitulo</w>
              <pc resp="#editor">,</pc>
            </seg>
            <seg type="hemistich">
              <w>caper</w>
              <w>et</w>
              <w>capella</w>
              <pc resp="#editor">.</pc>
            </seg>
          </l>
        </lg>
      </div>
    </body>

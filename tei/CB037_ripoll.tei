  <text>
    <body>
      <div type="poem" met="3x(8pp+7p) 7p 8pp+7p">
        <lg type="strophe" met="8pp+7p/8pp+7p/8pp+7p/7p/8pp+7p" rhyme="a+b/a+b/a+b/b/a+b" xml:id="CB037_ripoll-lg-1">
          <l n="1" xml:id="CB037_ripoll-l-1">
            <seg type="hemistich">
              <w>In</w>
              <w>Gedeonis</w>
              <w>area</w>
            </seg>
            <seg type="hemistich">
              <w>vellus</w>
              <w>aret</w>
              <w>extentum</w>
            </seg>
          </l>
          <l n="2" xml:id="CB037_ripoll-l-2">
            <seg type="hemistich">
              <w>et</w>
              <w>demolitur</w>
              <w>timea</w>
            </seg>
            <seg type="hemistich">
              <w>regale</w>
              <w>vestimentum</w>
            </seg>
          </l>
          <l n="3" xml:id="CB037_ripoll-l-3">
            <seg type="hemistich">
              <w>super</w>
              <w>habundat</w>
              <w>palea</w>
            </seg>
            <seg type="hemistich">
              <w>que</w>
              <w>sepelit</w>
              <w>frumentum</w>
            </seg>
          </l>
          <l n="4" xml:id="CB037_ripoll-l-4">
            <w>et</w>
            <w>loquitur</w>
            <w>iumentum</w>
          </l>
          <l n="5" xml:id="CB037_ripoll-l-5">
            <seg type="hemistich">
              <w>non</w>
              <w>redit</w>
              <w>bos</w>
              <w>ad</w>
              <w>orrea</w>
            </seg>
            <seg type="hemistich">
              <w>sed</w>
              <w>sequitur</w>
              <w>carpentum</w>
            </seg>
          </l>
        </lg>
      </div>

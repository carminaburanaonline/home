            <w>obprobrio</w>
          </l>
          <l n="4" xml:id="CB037_ripoll-l-31">
            <w>per</w>
            <w>vulgus</w>
            <w>indiscretum</w>
            <pc resp="#editor">,</pc>
          </l>
          <l n="5" xml:id="CB037_ripoll-l-32">
            <w>quod</w>
